{
  "manifest_version": 3,
  "name": "Job Extractor \u2013 Detailed OnlineJobs.ph & JobStreet",
  "version": "1.2.0",
  "description": "Extract detailed job overviews, skill requirements, and job metadata from OnlineJobs.ph and JobStreet Philippines.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Extract job as JSON",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onlinejobs.ph/*",
        "https://*.onlinejobs.ph/*",
        "https://ph.jobstreet.com/*",
        "https://jobstreet.com/*",
        "https://*.jobstreet.com/*",
        "https://jobstreet.com.ph/*",
        "https://*.jobstreet.com.ph/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}